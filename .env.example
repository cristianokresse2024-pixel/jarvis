# ============================================================
#  J.A.R.V.I.S. - chaves de API
#  Copie este arquivo para ".env" e preencha com SUA chave.
#  O arquivo .env NÃO vai para o git (está no .gitignore).
# ============================================================

# Groq - chave começa com "gsk_" (crie em https://console.groq.com/keys)
GROQ_API_KEY=gsk_cole_sua_chave_aqui

# OpenAI - opcional (começa com "sk-", crie em https://platform.openai.com)
OPENAI_API_KEY=
