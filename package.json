{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "JARVIS - assistente pessoal com voz e IA (Homem de Ferro style)",
  "type": "module",
  "bin": "server.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:win": "pkg . --targets node22-win-x64 --output dist/jarvis.exe",
    "build:linux": "pkg . --targets node22-linux-x64 --output dist/jarvis-linux",
    "build:mac": "pkg . --targets node22-macos-x64 --output dist/jarvis-mac"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
